load("@rules_lean//lean:lean.bzl", "lean_emit", "lean_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "lakefile.lean",
    "lake-manifest.json",
    "lean-toolchain",
])

# Toolchain smoke: passes iff the Lean toolchain elaborates a trivial file.
# Phase 1 adds the Money / double-entry `lean_test` proofs here.
lean_test(
    name = "smoke_test",
    size = "small",
    srcs = ["Smoke.lean"],
    entry = "Smoke.lean",
)

# The proven accounting model: Money forms a commutative group; two-leg postings
# balance; the five normal-balance rules hold. Passes iff every theorem in
# Ratio/Core.lean elaborates (the proofs ARE the test).
lean_test(
    name = "money_proof_test",
    size = "small",
    srcs = ["Ratio/Core.lean"],
    entry = "Ratio/Core.lean",
)

# ─── Lean → Rust emit pipeline (Phase 0b) ──────────────────────────────────
# `Ratio.Common.Emit` builds ratio-common's items as a syn::File JSON via the
# vendored `Polyglot.Rust` builders; `json_to_rust` renders it to formatted
# Rust. Phase 0b smoke: a `Money` struct. Phase 1 grows the kernel + adds the
# `lean_regen_test` gate against a committed `crates/ratio-common/src/lib.rs`.
_EMITTER_SRCS = [
    "Polyglot/Rust/RustAst.lean",
    "Polyglot/Rust/Builders.lean",
    "Ratio/Common/Emit.lean",
]

lean_emit(
    name = "ratio_common_ast",
    srcs = _EMITTER_SRCS,
    entry = "Ratio/Common/Emit.lean",
    out = "ratio_common.ast.json",
)

genrule(
    name = "ratio_common_rs",
    srcs = [":ratio_common_ast"],
    outs = ["ratio_common.gen.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath :ratio_common_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

# The compile + regen gate live in the consumer crate
# (//crates/ratio-common): rust_library over the committed src/generated.rs +
# a diff_test against :ratio_common_rs.
