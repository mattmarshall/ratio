load("@rules_lean//lean:lean.bzl", "lean_emit", "lean_test")

# Every Lean source that carries proofs or emits code. `lakefile.lean` is Lake
# build configuration, not a development, so it is not audited.
_LEAN_SRCS = glob(
    ["**/*.lean"],
    exclude = ["lakefile.lean"],
)

package(default_visibility = ["//visibility:public"])

exports_files([
    "lakefile.lean",
    "lake-manifest.json",
    "lean-toolchain",
])

# Toolchain smoke: passes iff the Lean toolchain elaborates a trivial file.
# Phase 1 adds the Money / double-entry `lean_test` proofs here.
lean_test(
    name = "smoke_test",
    size = "small",
    srcs = ["Smoke.lean"],
    entry = "Smoke.lean",
)

# The proven kernel (research.tex): integer vectors form a commutative group;
# conservation is a subgroup; the ledger fold of conserving transactions
# conserves value; double-entry is the 1-D instance. Passes iff every theorem in
# Ratio/Core.lean elaborates (the proofs ARE the test).
lean_test(
    name = "money_proof_test",
    size = "small",
    srcs = ["Ratio/Core.lean"],
    entry = "Ratio/Core.lean",
)

# The chart layer: the trial balance ties (debits = credits is a restatement of
# conservation, not a second check), and a balanced posting template stays
# balanced at every amount it is applied at. Passes iff every theorem in
# Ratio/Chart.lean elaborates.
lean_test(
    name = "chart_proof_test",
    size = "small",
    srcs = [
        "Ratio/Chart.lean",
        "Ratio/Core.lean",
    ],
    entry = "Ratio/Chart.lean",
)

# The data plane's proved core: resolution can only go forwards (a reference
# that resolved never goes absent when the master grows), an empty identity
# ladder matches nothing rather than everything, silence about an attribute is
# not agreement with a claim about it, and the decimal→minor-units conversion is
# a multiplication with no division for a rounding decision to hide in.
lean_test(
    name = "ingest_proof_test",
    size = "small",
    srcs = ["Ratio/Ingest.lean"],
    entry = "Ratio/Ingest.lean",
)

# Marking a book to market, proved before it is built. A mark is a POSTING and
# not an assignment: it conserves, it lands on market value, marking twice at
# one price posts nothing, and a position with no price yields NO mark rather
# than a zero one.
lean_test(
    name = "valuation_proof_test",
    size = "small",
    srcs = ["Ratio/Valuation.lean"],
    entry = "Ratio/Valuation.lean",
)

# The day a fund is valuing. Settles what carrying that on the fund constrains,
# BEFORE any of it is built: the day only moves forward, moving on never erases
# what a day held, a day is struck at most once, and a skipped day is a visible
# gap rather than a silent zero.
#
# ⚠ `struck` IS INDEXED BY VIEW NOW. A fund keeps more than one book of record,
# so a valuation point has one answer PER VIEW — a widening of
# `one_answer_per_day`, not a weakening of it, and the file argues why at
# length. Two facts come with it: striking a second view on a day the first has
# already struck succeeds and disturbs nothing, and a view that has not struck a
# day says so rather than borrowing its sibling's figure.
lean_test(
    name = "period_proof_test",
    size = "small",
    srcs = ["Ratio/Period.lean"],
    entry = "Ratio/Period.lean",
)

# One journal, more than one answer. A view is a recognition PREDICATE — not a
# conserved dimension, not a partition, not a second book — so it filters whole
# entries and every view's books tie. The load-bearing pair is that two views
# differ by exactly the entries in flight between them (which is what makes the
# reconciliation a list rather than a hunt) and that a fold with no CUT hides
# the whole difference (which is what makes a differential test over one
# vacuous). Settled here before any of it is built.
lean_test(
    name = "views_proof_test",
    size = "small",
    srcs = [
        "Ratio/Core.lean",
        "Ratio/Views.lean",
    ],
    entry = "Ratio/Views.lean",
)

# Tax lots at scale. Every optimization a twenty-million-lot book needs — an
# index, a cached aggregate, a partition — is a claim of equality with the naive
# fold, and each is proved here rather than hoped for. The load-bearing one is
# that a sale costs what it CONSUMES rather than what the fund HOLDS.
lean_test(
    name = "lots_proof_test",
    size = "small",
    srcs = ["Ratio/Lots.lean"],
    entry = "Ratio/Lots.lean",
)

# Two plans for one question, and what makes them the same answer. The cost
# functions are counts rather than seconds — what they are for is turning the
# dial (500 securities, 10,000 lots each) and reading off which term moves.
lean_test(
    name = "plan_proof_test",
    size = "small",
    srcs = ["Ratio/Plan.lean"],
    entry = "Ratio/Plan.lean",
)

# Everything a period end needs, and what each term costs. The terms are not
# alike: marking is per security, fx is per CURRENCY, corporate actions are the
# only superlinear and only retroactive one, and per-share is the one division
# in this system that must round.
lean_test(
    name = "closure_proof_test",
    size = "small",
    srcs = ["Ratio/Closure.lean"],
    entry = "Ratio/Closure.lean",
)

# Corporate actions, which behave like nothing else here: they conserve COST
# while deliberately changing UNITS, they are RETROACTIVE, and — against every
# reflex the rest of this system teaches — they are NOT IDEMPOTENT. Applying a
# two-for-one twice quadruples the position and the trial balance still ties.
lean_test(
    name = "actions_proof_test",
    size = "small",
    srcs = ["Ratio/Actions.lean"],
    entry = "Ratio/Actions.lean",
)

# A split as something you READ THROUGH rather than something you write.
#
# `Ratio.Closure` makes actions the only superlinear term, and that cost is
# entirely an artifact of rewriting every affected lot. Composing the splits
# into a factor removes the rewrite — but NOT for free, and this file proves
# both halves: the factor describes the rewrite (multiplicatively, so no
# rounding can make it true), AND it succeeds where the rewrite refuses, in
# which case it is the factor that is wrong about the world.
#
# It also carries the precondition the redesign turns on: a strike's factor
# must be fixed by the journal prefix it pinned, which is only true if
# announcements are journal entries.
lean_test(
    name = "actions_factor_proof_test",
    size = "small",
    srcs = [
        "Ratio/Actions.lean",
        "Ratio/Actions/Factor.lean",
    ],
    entry = "Ratio/Actions/Factor.lean",
)

# ⛔ Two compartments that do not substitute for each other.
#
# `Ratio.Closure` counts reads, which proves the thing that matters most — a NAV
# never reads the tax lots — but says nothing about what adding workers does.
# This does, and the answer is mostly NO: there is one store, so IO adds up
# across partitions while only CPU divides, and no partition beats the IO floor.
#
# Which is also why the factor redesign matters more than the executor: removing
# forty thousand lot rewrites removes IO, and IO is the term concurrency cannot
# reach.
lean_test(
    name = "exec_proof_test",
    size = "small",
    srcs = ["Ratio/Exec.lean"],
    entry = "Ratio/Exec.lean",
)

# ⛔ How big a difference has to be before it stops the NAV — a term of an
# administration agreement, not a property of the software. Two funds looking at
# the same break disagree about whether it matters and both are right.
#
# The theorem worth knowing about is `an_inverted_tolerance_makes_the_middle_
# band_unreachable`: bounds the wrong way round leave a grade nothing can ever
# be, which is why `wellFormed` is checked when the configuration is READ.
lean_test(
    name = "tolerance_proof_test",
    size = "small",
    srcs = ["Ratio/Tolerance.lean"],
    entry = "Ratio/Tolerance.lean",
)

# ─── Lean → Rust emit pipeline ─────────────────────────────────────────────
# Each `Ratio.*.Emit` builds its crate's items as a syn-serde JSON `syn::File`
# via the vendored `Polyglot.Rust` builders. These `lean_emit` targets produce
# the JSON; each consumer crate (//crates/*) renders it to Rust (json_to_rust)
# directly into its `src/generated.rs` and compiles it — one DAG, no copy.
_BUILDER_SRCS = [
    "Polyglot/Rust/RustAst.lean",
    "Polyglot/Rust/Builders.lean",
]

lean_emit(
    name = "ratio_common_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Common/Emit.lean"],
    entry = "Ratio/Common/Emit.lean",
    out = "ratio_common.ast.json",
)

lean_emit(
    name = "ratio_kernel_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Kernel/Emit.lean"],
    entry = "Ratio/Kernel/Emit.lean",
    out = "ratio_kernel.ast.json",
)

lean_emit(
    name = "ratio_ingest_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Ingest/Emit.lean"],
    entry = "Ratio/Ingest/Emit.lean",
    out = "ratio_ingest.ast.json",
)

lean_emit(
    name = "ratio_chart_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Chart/Emit.lean"],
    entry = "Ratio/Chart/Emit.lean",
    out = "ratio_chart.ast.json",
)

# The cost model. Emitted rather than rewritten because the whole value of the
# answer is that it IS `Ratio.Closure` — a hand-written `nav_cost` in Rust would
# be a claim about the proofs instead of the thing they are about.
# ⛔ WHERE A REALIZED GAIN GOES. The engine computes one and nothing posts it —
# six methods and holding-period classification deciding a number that is then
# discarded.
#
# A gain is the ONE figure a transaction creates rather than moves, which is why
# the posting has three legs. And the failure to prevent is the gain computed
# TWICE: if the entry carries its own figure and the relief carries another, the
# entry still BALANCES — the gain leg absorbs the difference — and the taxable
# income is wrong by the drift.
lean_test(
    name = "lots_posting_proof_test",
    size = "small",
    srcs = [
        "Ratio/Chart/Dimensions.lean",
        "Ratio/Lots.lean",
        "Ratio/Lots/Posting.lean",
    ],
    entry = "Ratio/Lots/Posting.lean",
)

# ⛔ What a chart of accounts IS, on a kernel that conserves vectors.
#
# `Ratio.Core.Conserves` is zero in EVERY dimension and `Dim` is the
# conserved-quantity basis. The running kernel collapsed that to one number — sum
# every amount, require zero — and the collapse loses multi-currency: USD +100
# against EUR −100 sums to zero and neither currency balances.
#
# The architecture is a classification, and it is the whole design. CURRENCY
# conserves, and two of them are two independent laws rather than one over a sum.
# ACCOUNT, instrument and class PARTITION — they say where the value sits, they
# do not net to zero, and a breakdown rolls up. QUANTITY is MEASURED: buying a
# hundred shares creates a hundred in the book, so a conservation check over
# units would refuse every purchase.
lean_test(
    name = "chart_dimensions_proof_test",
    size = "small",
    srcs = ["Ratio/Chart/Dimensions.lean"],
    entry = "Ratio/Chart/Dimensions.lean",
)

# ⛔ The hypothesis every theorem in this repo was assuming.
#
# Every proof here is over Lean's unbounded `Int`; every emitted function runs on
# `i64`. Nothing had written down what happens in the gap, and the answer is
# worse than a crash: 4e18 * 3 wraps NEGATIVE, and `rem_euclid 2` of the wrapped
# value is 0 — so a divisibility guard says YES about a product that never
# happened, and the proof cannot see it because in `Int` the multiplication
# simply happened.
#
# Three are live on the emitted surface: `per_share(x, 0)` PANICS, `per_share(
# MIN, -1)` PANICS, and `money_neg(MIN)` returns its argument unchanged in a
# kernel whose subject is that debits and credits cancel.
lean_test(
    name = "bounded_proof_test",
    size = "small",
    srcs = ["Ratio/Bounded.lean"],
    entry = "Ratio/Bounded.lean",
)

# The lots that are NOT ordinary.
#
# ⛔ A lot holding zero units and carrying cost is CONSUMED by `relieveFifo` —
# `units <= want` is satisfied by zero — and hands its whole basis to a sale that
# received no units for it. Cost conserved, units conserved, realized gain
# understated by exactly the husk. Every invariant this system had holds of the
# wrong answer.
#
# ⛔ And `relieveFifo` does not sort: it takes the head, so it is FIFO exactly
# when the caller handed it acquisition order. Named for a policy it does not
# enforce.
lean_test(
    name = "lots_edges_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Edges.lean",
    ],
    entry = "Ratio/Lots/Edges.lean",
)

# ⛔ WHICH lots a sale gives up, and why it is not a detail. The choice decides
# the REALIZED GAIN — same holding, same trade, different taxable income, with
# no figure on the balance sheet moving.
#
# And the space is not all orderings: FIFO/LIFO/HIFO/LOFO sort and walk;
# SPECIFIC IDENTIFICATION is a selection that may take from the middle; AVERAGE
# COST pools the holding and has no lot to give up at all.
lean_test(
    name = "lots_methods_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
    ],
    entry = "Ratio/Lots/Methods.lean",
)

# What a sale PRODUCES, not just what it consumes.
#
# `Ratio.Lots` proves relief conserves and says nothing about the realized gain,
# the method that chose the lots, or selling through open splits. All three are
# things an engine needs and none of them follow from conservation — which is
# equally true of a book that posted no gain at all.
lean_test(
    name = "lots_relief_proof_test",
    size = "small",
    srcs = [
        "Ratio/Actions.lean",
        "Ratio/Actions/Factor.lean",
        "Ratio/Lots.lean",
        "Ratio/Lots/Relief.lean",
    ],
    entry = "Ratio/Lots/Relief.lean",
)

# The per-lot relief decisions. The WALK is a Rust fold — lots page out of a
# store — and what is emitted is what the walk decides at each lot, which is
# where a mistake would be invisible: the `<=` that keeps a whole sale from
# leaving a husk, and the pro-rata split that refuses rather than rounding.
lean_emit(
    name = "ratio_lots_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Lots/Emit.lean"],
    entry = "Ratio/Lots/Emit.lean",
    out = "ratio_lots.ast.json",
)

# Corporate actions read as factors: the PER-STEP guard, not a composed ratio.
# `Ratio.Actions.Factor.a_factor_can_succeed_where_the_rewrite_refuses` is why —
# composing 3-for-2 and 2-for-1 divides five units cleanly and silently swallows
# the half-share the holder was paid cash for.
lean_emit(
    name = "ratio_actions_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Actions/Emit.lean"],
    entry = "Ratio/Actions/Emit.lean",
    out = "ratio_actions.ast.json",
)

# The planner's decision, emitted. The folds stay in Rust and ask this what to
# do — `Ratio.Exec.a_plan_that_cannot_be_helped_takes_its_io` is the bridge.
lean_emit(
    name = "ratio_exec_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Exec.lean", "Ratio/Exec/Emit.lean"],
    entry = "Ratio/Exec/Emit.lean",
    out = "ratio_exec.ast.json",
)

# ⛔ The grading decision, so the console's loop over a report's lines and the
# theorems about severity cannot come to disagree — `Ratio.Tolerance.the_three_
# bands_partition_every_difference` is the bridge. ⚠ The magnitude is a
# PARAMETER: negation is the one operation here that can fail on `i64`, so the
# Rust takes a checked absolute value before it asks anything.
lean_emit(
    name = "ratio_tolerance_ast",
    srcs = _BUILDER_SRCS + [
        "Ratio/Tolerance.lean",
        "Ratio/Tolerance/Emit.lean",
    ],
    entry = "Ratio/Tolerance/Emit.lean",
    out = "ratio_tolerance.ast.json",
)

lean_emit(
    name = "ratio_closure_ast",
    srcs = _BUILDER_SRCS + ["Ratio/Closure/Emit.lean"],
    entry = "Ratio/Closure/Emit.lean",
    out = "ratio_closure.ast.json",
)

# `set_option warningAsError true` makes a `sorry` a hard error, but it says
# nothing about a declared `axiom` or `native_decide` — both of which would let
# a green build mean nothing. This asserts, textually, that no source contains
# either, and that every source carries the option.
sh_test(
    name = "audit_proofs_test",
    size = "small",
    srcs = ["audit_proofs.sh"],
    args = ["$(rootpaths :lean_srcs)"],
    data = [":lean_srcs"],
)

filegroup(
    name = "lean_srcs",
    srcs = _LEAN_SRCS,
)

# A period close: the surplus roll-forward, and the refuse. Settled here
# before any of it is built. The closing posting conserves and the equity
# leg IS the surplus; a missing destination or a missing beginning stays
# unset rather than a measured zero; a dated entry on or before the
# closed-through day is refused; a close only moves forward.
#
# ⚠ NOT `Ratio.Period` AND NOT `CloseGate`. Those are the NAV valuation day
# and whether a strike may be taken over an unexplained break. This is a
# fiscal boundary per book of record.
lean_test(
    name = "close_proof_test",
    size = "small",
    srcs = ["Ratio/Close.lean"],
    entry = "Ratio/Close.lean",
)

# A loss the rule DEFERS, and the ways an engine removes it.
#
# ⛔ THE SECOND HALF OF THE RULE IS THE ONE THAT GETS DROPPED. Disallowing a loss
# without attaching it to the replacement lot's basis does not partially
# implement the rule — it permanently overtaxes the investor, and it does so
# while cost is conserved, the trial balance ties and the digest reproduces. The
# figure that goes wrong is the realized gain, which has no counterparty and so
# no reconciliation reaches it.
#
# `attachTo` is the write: a mutation of a lot the sale did not relieve. The
# search is over the remainder, so writing a Taken lot is unrepresentable.
# `//tla:wash_engine_check` is the sequence that write sits in.
lean_test(
    name = "lots_wash_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/Wash.lean",
    ],
    entry = "Ratio/Lots/Wash.lean",
)

# A struck figure that a later wash moved must not change silently.
#
# ⛔ THE OBLIGATION IS ABOUT THE RECORD, NOT THE NUMBER. The tax rule
# genuinely reaches backwards, so holding March fixed would report a
# number the rule disagrees with. What is forbidden is rewriting the
# citeable strike in place. Restatement is a new record that cites what
# it supersedes — `Ratio.Period`'s "new kind of thing", for this rule.
#
# `//tla:wash_restatement_check` is the sequence.
# `//tla:silent_wash_restatement_check` skips the record.
# `//tla:mutating_wash_restatement_check` overwrites the figure.
lean_test(
    name = "lots_wash_restatement_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/Wash.lean",
        "Ratio/Lots/WashRestatement.lean",
    ],
    entry = "Ratio/Lots/WashRestatement.lean",
)

# ⛔ A ranking at a PRICE, not a sort of the holding.
#
# `Ratio.Lots.Methods.a_tax_minimising_method_is_not_a_function_of_the_lots`
# is the inequality: same two lots, two prices, the cheaper-tax lot flips.
# This file is the ranking that inequality describes. Adding MinTax as an
# `Order` / `Method` variant is the mistake that file exists to prevent.
#
# `//tla:mintax_engine_check` is the sequence: a sort-and-walk that never
# sees the price cannot flip. `//tla:sort_and_walk_mintax_check` is the
# probe.
lean_test(
    name = "lots_mintax_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/MinTax.lean",
    ],
    entry = "Ratio/Lots/MinTax.lean",
)

# ⛔ A SELECTION the taxpayer names, not a sort of the holding.
#
# `Ratio.Lots.Methods` already said specific identification is not an
# `Order`: the client names the lots, possibly from the middle.
# `selectFirst` puts those names first and cannot refuse a contradictory
# instruction. This file is the surface that can — unknown, overspecified,
# insufficient and unnamed selections refuse rather than walk.
#
# `//tla:specid_engine_check` is the sequence: a sort-and-walk that never
# sees the name cannot take the middle lot.
# `//tla:sort_and_walk_specid_check` is the probe.
lean_test(
    name = "lots_specid_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/SpecId.lean",
    ],
    entry = "Ratio/Lots/SpecId.lean",
)

# ⛔ A POOL of the holding, not a sort of the lots.
#
# `Ratio.Lots.Methods.average_cost_is_not_a_lot_walk` already said
# average cost is not an `Order`: every unit has the same basis, so
# "which lot" is not a question it answers, and the figure divides.
# This file is the surface that relieves from the pool — a remainder
# that is one lot, not the other lots left intact.
#
# `//tla:average_cost_engine_check` is the sequence: a sort-and-walk
# that never pools cannot give up the unit basis.
# `//tla:sort_and_walk_average_cost_check` is the probe.
lean_test(
    name = "lots_average_cost_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/AverageCost.lean",
    ],
    entry = "Ratio/Lots/AverageCost.lean",
)

# ⛔ A partner allocation cut, not a silent 1/N of book NAV.
#
# `/capital` allocated income / expense / unrealized stay unset without
# a named cut. Inventing an equal split from the partner count would
# print somebody else's share while the books still tie. This file is
# the cut: named weights that must divide exactly, specials that
# replace the default for one kind, journal facts that are exact
# amounts. `Some []` refuses the SpecID way.
lean_test(
    name = "partners_cut_proof_test",
    size = "small",
    srcs = ["Ratio/Partners/Cut.lean"],
    entry = "Ratio/Partners/Cut.lean",
)

# ⛔ The date a pooled holding carries, not a category.
#
# `Ratio.Lots.AverageCost` pools the basis. US single-category invents
# FIFO's oldest date on a mixed pool and classifies the sale long-term.
# Double-category invents two pools. Both invent a short-vs-long answer
# the lots do not support. This file is the honest rule — a shared date
# when every lot agrees, unset when mixed or missing. Not an `Order`,
# not a `Method`, not a `lot_method` variant.
#
# `//tla:pool_period_engine_check` is the sequence: treating mixed
# dates as FIFO invents long-term. The probe
# `//tla:sort_and_walk_pool_period_check` flips the dial.
lean_test(
    name = "lots_pool_period_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/PoolPeriod.lean",
    ],
    entry = "Ratio/Lots/PoolPeriod.lean",
)

# ⛔ Subscriptions and redemptions as unit/capital movements.
#
# Money already cites contribution / distribution. Units in issue stay
# unset until a unit event posts — a silent 0 on a PE-style contribution
# is the defect. After a full redemption, some 0 is a real zero.
# Allocating units across partners uses the named cut, not 1/N.
lean_test(
    name = "partners_units_proof_test",
    size = "small",
    srcs = [
        "Ratio/Partners/Cut.lean",
        "Ratio/Partners/Units.lean",
    ],
    entry = "Ratio/Partners/Units.lean",
)

# ⛔ Management-fee accrual as a conserved receivable/expense posting.
#
# Stage 1 already has the rule (rate, day-count, balanced template).
# The books half: an elected rule posts, and the receivable stays
# unset when fee terms are absent — never a silent zero receivable.
# Same-sign legs are not an accrual. Invoice / LP stay Connect.
lean_test(
    name = "fees_accrual_proof_test",
    size = "small",
    srcs = ["Ratio/Fees/Accrual.lean"],
    entry = "Ratio/Fees/Accrual.lean",
)

# ⛔ A jurisdiction that does NOT transfer the holding period.
#
# `Ratio.Lots.Wash.replacementAcquired` is the US rule. Assuming it
# everywhere classifies a non-US replacement at the US rate. Conservation
# holds, the trial balance ties, the deferred loss still attaches. The
# figure that goes wrong is the RATE. This file is the election — not an
# `Order`, not a `Method`, not `lot_method = "wash"`.
#
# `//tla:wash_holding_check` is the sequence. The probe
# `//tla:universal_us_transfer_check` hardcodes the US transfer.
lean_test(
    name = "lots_wash_holding_proof_test",
    size = "small",
    srcs = [
        "Ratio/Lots.lean",
        "Ratio/Lots/Methods.lean",
        "Ratio/Lots/Wash.lean",
        "Ratio/Lots/WashHolding.lean",
    ],
    entry = "Ratio/Lots/WashHolding.lean",
)
