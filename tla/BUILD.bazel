load("@rules_tla//tla:defs.bzl", "tla_check", "tla_library")

package(default_visibility = ["//visibility:public"])

# ⛔ The properties Lean does not reach.
#
# `Ratio.Ingest` proves what resolution and parsing COMPUTE. It cannot say
# what a sequence of operations does to shared state — and that is where the
# bug that shipped lived: approving a rule deleted the templates beside it,
# after which every Lean theorem held vacuously over an empty set of facts.
tla_library(
    name = "control_plane",
    srcs = ["ControlPlane.tla"],
)

# The system as it is now. Both invariants must hold.
tla_check(
    name = "control_plane_check",
    size = "medium",
    config = "MCControlPlane.cfg",
    module = "MCControlPlane.tla",
    deps = [":control_plane"],
)

# Marking to market. `Ratio.Valuation` proves what ONE mark does; this is what
# a SEQUENCE of them does to the carrying value, which marking, trading and
# price corrections all write.
tla_library(
    name = "valuation",
    srcs = ["Valuation.tla"],
)

tla_check(
    name = "valuation_check",
    size = "medium",
    config = "MCValuation.cfg",
    module = "MCValuation.tla",
    deps = [":valuation"],
)

# Relieving tax lots at scale. `Ratio.Lots` proves the ARITHMETIC of one
# relief; twenty million lots do not fit in one application, and paging them
# through an I/O compartment into CPU workers is where a proved function starts
# giving a different answer.
tla_library(
    name = "lot_engine",
    srcs = ["LotEngine.tla"],
)

tla_check(
    name = "lot_engine_check",
    size = "medium",
    config = "MCLotEngine.cfg",
    module = "MCLotEngine.tla",
    deps = [":lot_engine"],
)

# Corporate actions arriving, being applied, and NAVs struck around them.
# `Ratio.Actions` proves what ONE does; non-idempotence and retroactivity are
# sequence problems, which is this.
tla_library(
    name = "actions",
    srcs = ["Actions.tla"],
)

tla_check(
    name = "actions_check",
    size = "medium",
    config = "MCActions.cfg",
    module = "MCActions.tla",
    deps = [":actions"],
)

# ─── failure-path probes ──────────────────────────────────────────────────
#
# Each of these MUST go red. Tagged manual so `bazel test //...` stays green;
# run them explicitly. A check that cannot fail is not a check, and this spec
# exists because two things that could not fail had already been believed.
tla_check(
    name = "approve_drops_sections_check",
    size = "medium",
    config = "ApproveDropsSections.cfg",
    module = "ApproveDropsSections.tla",
    tags = ["manual"],
    deps = [":control_plane"],
)

tla_check(
    name = "master_duplicates_check",
    size = "medium",
    config = "MasterDuplicates.cfg",
    module = "MasterDuplicates.tla",
    tags = ["manual"],
    deps = [":control_plane"],
)

# ⛔ Marking from COST rather than from the carrying value. Every mark posts the
# whole gain again — and the entry is still BALANCED, so the trial balance ties
# while the book is wrong. Conservation cannot catch this, which is exactly why
# the property is worth checking.
tla_check(
    name = "mark_from_cost_check",
    size = "medium",
    config = "MarkFromCost.cfg",
    module = "MarkFromCost.tla",
    tags = ["manual"],
    deps = [":valuation"],
)

# ⛔ Two sales inside one shard. Each one's arithmetic is impeccable — the
# proofs in `Ratio.Lots` hold of both — and the instrument ends up relieved for
# more than it held. Conservation of a single relief cannot see this.
tla_check(
    name = "shared_shard_check",
    size = "medium",
    config = "SharedShard.cfg",
    module = "SharedShard.tla",
    tags = ["manual"],
    deps = [":lot_engine"],
)

# ⛔ No record of having applied. A retry re-applies a split; the cost is
# unchanged so the trial balance still ties, and the position silently doubles.
# Every other write in this system is safe to retry, which is exactly why this
# one needs a guard rather than a habit.
tla_check(
    name = "reapply_action_check",
    size = "medium",
    config = "ReapplyAction.cfg",
    module = "ReapplyAction.tla",
    tags = ["manual"],
    deps = [":actions"],
)

# ⛔ Applied in arrival order rather than ex-date order. Actions do not commute
# — `Ratio.Actions.actions_do_not_commute` — so this is not a performance
# question, it decides whether the book can be brought up to date at all.
tla_check(
    name = "out_of_order_action_check",
    size = "medium",
    config = "OutOfOrderAction.cfg",
    module = "OutOfOrderAction.tla",
    tags = ["manual"],
    deps = [":actions"],
)

# ⛔ The derived read model, and the one way it silently produces a wrong figure.
#
# Twenty million lots do not scan through the journal quickly — 89 seconds at
# the rate `ratio_nav::closure::measure` reports — so reads move to a projection
# folded from a journal prefix. That is safe only if a strike pins the prefix it
# actually read. Pinning the journal HEAD while reading a lagging projection
# passes every downstream check: the trial balance ties, the digest is
# well-formed, and `ratio replay` disagrees with the figure it was asked to
# confirm.
#
# It also carries `Ratio.Actions.Factor`'s precondition into the system: under
# the factor representation nothing is applied, so a corporate action in a side
# plane is pinned by no strike and a replay reads whatever arrived since.
tla_library(
    name = "projection",
    srcs = ["Projection.tla"],
)

tla_check(
    name = "projection_check",
    size = "medium",
    config = "MCProjection.cfg",
    module = "MCProjection.tla",
    deps = [":projection"],
)

# ⛔ The strike pins the journal head while reading a lagging projection — the
# obvious, tempting bug, because the head is the number closest to hand.
# StrikeFoldsItsOwnPrefix goes red.
tla_check(
    name = "unpinned_projection_check",
    size = "medium",
    config = "UnpinnedProjection.cfg",
    module = "UnpinnedProjection.tla",
    tags = ["manual"],
    deps = [":projection"],
)

# ⛔ A rebuild that re-folds from zero onto state it already holds. Its claimed
# position stays honest and its contents do not, so nothing about the resulting
# number looks wrong — it is simply too big.
# ProjectionIsTheFold goes red.
tla_check(
    name = "rebuild_double_counts_check",
    size = "medium",
    config = "RebuildDoubleCounts.cfg",
    module = "RebuildDoubleCounts.tla",
    tags = ["manual"],
    deps = [":projection"],
)

# ⛔ Corporate actions in a side plane, which is where `Plane::Actions` has them
# today. `Ratio.Actions.Factor.an_unpinned_announcement_changes_the_answer` is
# one step of this; here it is a run.
# ReplayReproduces goes red.
tla_check(
    name = "announcements_in_side_log_check",
    size = "medium",
    config = "AnnouncementsInSideLog.cfg",
    module = "AnnouncementsInSideLog.tla",
    tags = ["manual"],
    deps = [":projection"],
)

# ⛔ Partitions handed to workers. `Ratio.Exec` proves what a partitioning
# COSTS; this is whether the partitions all ran, ran once, and were finished
# when somebody read the answer.
#
# Both failures here are arithmetically silent. A partition run twice
# double-counts, and every number in the doubled total is correct arithmetic on
# real rows. A partial result read as a whole one is simply LOW — no null, no
# ragged edge — and by the time anybody could tell, it has been struck and
# `one_answer_per_day` refuses to replace it.
tla_library(
    name = "executor",
    srcs = ["Executor.tla"],
)

tla_check(
    name = "executor_check",
    size = "medium",
    config = "MCExecutor.cfg",
    module = "MCExecutor.tla",
    deps = [":executor"],
)

# ⛔ No claim before work: two workers take the same partition, both compute it
# correctly, and the total double-counts.
# NoPartitionRunsTwice goes red.
tla_check(
    name = "unclaimed_partitions_check",
    size = "medium",
    config = "UnclaimedPartitions.cfg",
    module = "UnclaimedPartitions.tla",
    tags = ["manual"],
    deps = [":executor"],
)

# ⛔ Results published as each partition lands, so a reader arriving early folds
# part of the data into a figure that looks exactly like a whole one.
# CommitIsAllOrNothing goes red.
tla_check(
    name = "partial_commit_check",
    size = "medium",
    config = "PartialCommit.cfg",
    module = "PartialCommit.tla",
    tags = ["manual"],
    deps = [":executor"],
)

# ⛔ Sales relieved while corporate actions keep arriving.
#
# `Ratio.Lots.Relief` proves what ONE relief computes; `//tla:lot_engine_check`
# proves no lot is relieved twice. Neither covers a relief that SPANS TIME —
# read the splits in force, convert the sale into stored units, then write.
#
# Under the factor representation nothing is rewritten, so a split landing
# between the read and the write changes what a stored unit MEANS without
# touching a lot. The relief then takes the wrong number of them, and the entry
# BALANCES, because the cost it relieved is the cost of the lots it took.
#
# ⚠ Separate from the projection spec because the RESOLUTION differs. A strike
# may be slightly behind and cite the prefix it read. A relief is a WRITE, and a
# relief that is slightly behind puts the wrong number of units into the book
# permanently — so it is refused and recomputed instead.
tla_library(
    name = "relief_engine",
    srcs = ["ReliefEngine.tla"],
)

tla_check(
    name = "relief_engine_check",
    size = "medium",
    config = "MCReliefEngine.cfg",
    module = "MCReliefEngine.tla",
    deps = [":relief_engine"],
)

# ⛔ Converted against the factor it read, written against whatever is current.
# ReliefIsWrittenAgainstWhatItRead goes red.
tla_check(
    name = "stale_factor_relief_check",
    size = "medium",
    config = "StaleFactorRelief.cfg",
    module = "StaleFactorRelief.tla",
    tags = ["manual"],
    deps = [":relief_engine"],
)

# ⛔ EVERY PROBE MUST BE ABLE TO SAY WHAT IT CLAIMS, and this is the only check
# of that which runs in CI.
#
# A probe exists to FAIL, so a human reads FAILED as success — which means every
# OTHER way of failing is indistinguishable from working. Adding a `CONSTANT` to
# ReliefEngine.tla made StaleFactorRelief.cfg die with "the constant parameter
# MaxConfigs is not assigned a value": still red, still looking like a probe
# doing its job, and no longer reaching the model at all.
#
# ⚠ IT DOES NOT RUN TLC. It checks each probe assigns every constant, names the
# invariant it breaks in the house form, lists that invariant so TLC is asked,
# and spells it the way the spec does. Whether the flipped dial still CAUSES the
# violation is `probes.sh`, which is a sweep somebody runs, not a test.
sh_test(
    name = "probes_test",
    size = "small",
    srcs = ["probes_test.sh"],
    args = ["$(rootpath probes_test.py)", "$(rootpath BUILD.bazel)"],
    data = ["BUILD.bazel", "probes_test.py"] + glob([
        "*.tla",
        "*.cfg",
    ]),
)

# ⛔ The sale is relieved under the method in force when the engine reaches it,
# rather than the one its own journal entry pinned. Unlike the factor probe
# above this needs no race to go wrong — it is wrong on every sale posted under
# a different rule set, and the books tie on all of them.
# ReliefUsesTheMethodItPinned goes red.
tla_check(
    name = "stale_method_relief_check",
    size = "medium",
    config = "StaleMethodRelief.cfg",
    module = "StaleMethodRelief.tla",
    tags = ["manual"],
    deps = [":relief_engine"],
)

# A loss disallowed by a repurchase that had not happened yet.
#
# ⛔ NOTHING IS STALE HERE, which is what makes it a different spec from
# `relief_engine`. The strike read the whole journal, pinned its prefix and
# computed the only correct answer available at the time; the figure moved
# because a FUTURE event reached backwards, which is a property of the tax rule
# rather than a defect in the engine.
#
# ⚠ SO THE OBLIGATION IS NOT "DO NOT LET IT CHANGE" — the rule genuinely reaches
# back, and an engine that held March fixed would report a number the rule
# disagrees with. It is that a figure somebody was paid on must not change
# SILENTLY: qualified when struck with the window open, restated when a later
# repurchase moves it.
tla_library(
    name = "wash_restatement",
    srcs = ["WashRestatement.tla"],
)

tla_check(
    name = "wash_restatement_check",
    size = "medium",
    config = "MCWashRestatement.cfg",
    module = "MCWashRestatement.tla",
    deps = [":wash_restatement"],
)

# ⛔ Struck clean, changed quietly. Two reproducible answers to one question and
# no record that they differ.
# AStruckGainThatMovedSaysSo goes red.
tla_check(
    name = "silent_wash_restatement_check",
    size = "medium",
    config = "SilentWashRestatement.cfg",
    module = "SilentWashRestatement.tla",
    tags = ["manual"],
    deps = [":wash_restatement"],
)

# The projection as TABLES, and the figure that straddles two of them.
#
# ⛔ `projection_check` PROVES A SCALAR AND POSTGRES HAS A FUNCTION. That spec's
# `projAt` is one position because the Rust projection is one object, and
# `AsOf<T>` makes dropping it a type error. Split the projection into lots,
# positions and aggregates — which is the whole point of issue #8 — and a figure
# is a query across more than one table, each at its own prefix. A NAV folded
# from positions at 100 and lots at 105 is internally consistent everywhere and
# is a figure that never existed.
#
# ⚠ TWO INDEPENDENT DIALS, AND NEITHER ALONE IS ENOUGH — which is what a model
# check says and reasoning does not. The two probes below go red on the SAME
# invariant by different routes: one writes atomically and reads torn, the other
# reads a perfect snapshot of tables that advanced independently.
tla_library(
    name = "sql_projection",
    srcs = ["SqlProjection.tla"],
)

tla_check(
    name = "sql_projection_check",
    size = "medium",
    config = "MCSqlProjection.cfg",
    module = "MCSqlProjection.tla",
    deps = [":sql_projection"],
)

# ⛔ A worker per table. Even a perfect snapshot sees two prefixes.
# AFigureIsFoldedFromOnePrefix goes red.
tla_check(
    name = "torn_projector_write_check",
    size = "medium",
    config = "TornProjectorWrite.cfg",
    module = "TornProjectorWrite.tla",
    tags = ["manual"],
    deps = [":sql_projection"],
)

# ⛔ Atomic writes, torn read. The projector commits between two statements of
# one figure, so atomicity on the write side alone does not save it.
# AFigureIsFoldedFromOnePrefix goes red.
tla_check(
    name = "torn_reader_straddle_check",
    size = "medium",
    config = "TornReaderStraddle.cfg",
    module = "TornReaderStraddle.tla",
    tags = ["manual"],
    deps = [":sql_projection"],
)

# The journal on an object store, one object per entry — issue #24's durable
# replacement for the per-container `/tmp` that forks.
#
# ⛔ `executor_check` PROVES A CLAIM AND S3 HAS A CONDITIONAL PUT. That spec's
# `ClaimBeforeWork` stops two workers taking one partition; here the same claim
# is an `If-None-Match:*` PUT that stops two writers taking one sequence key.
# The store is single, so the fork of #24 is gone — but a blind PUT to an
# occupied key overwrites it, and the losing entry was acked and is gone. The
# shortened journal ties, digests and replays, exactly like the double count.
tla_library(
    name = "s3_journal",
    srcs = ["S3Journal.tla"],
)

tla_check(
    name = "s3_journal_check",
    size = "medium",
    config = "MCS3Journal.cfg",
    module = "MCS3Journal.tla",
    deps = [":s3_journal"],
)

# ⛔ No condition on the PUT: two writers reserve one slot and the second
# overwrites the first, so an acked entry vanishes and the journal is a prefix
# short of the writes that believe they are in it.
# NoWriteIsLost goes red.
tla_check(
    name = "lost_write_check",
    size = "medium",
    config = "LostWrite.cfg",
    module = "LostWrite.tla",
    tags = ["manual"],
    deps = [":s3_journal"],
)

# ⛔ A NAV struck over a difference nobody has explained.
#
# `Ratio.Tolerance` proves which differences block. It cannot say what a
# SEQUENCE does — a reconciliation reporting a figure, a person explaining it,
# the journal growing, somebody striking — and the console reported
# `STATE_BLOCKED` for months with nothing consulting it before a strike.
#
# ⭐ The property worth the spec is `PostingDoesNotUnexplainABreak`. Pinning an
# explanation to the journal prefix its accepter read is the obvious design and
# it deadlocks: every note retired by the next posting, on the one morning a
# book posts constantly.
tla_library(
    name = "close_gate",
    srcs = ["CloseGate.tla"],
)

tla_check(
    name = "close_gate_check",
    size = "medium",
    config = "MCCloseGate.cfg",
    module = "MCCloseGate.tla",
    deps = [":close_gate"],
)

# ⛔ The gate the screen reported and the command never asked about.
# AStrikeIsNotTakenOverABlockingBreak goes red.
tla_check(
    name = "unexplained_high_strikes_check",
    size = "medium",
    config = "UnexplainedHighStrikes.cfg",
    module = "UnexplainedHighStrikes.tla",
    tags = ["manual"],
    deps = [":close_gate"],
)

# ⛔ A note that outlives the figure it was written about.
# ANewFigureRetiresItsExplanation goes red.
tla_check(
    name = "stale_explanation_unblocks_check",
    size = "medium",
    config = "StaleExplanationUnblocks.cfg",
    module = "StaleExplanationUnblocks.tla",
    tags = ["manual"],
    deps = [":close_gate"],
)

# ⭐ THE DESIGN THAT WAS NOT SHIPPED, demonstrated to deadlock. Pin the note to
# the prefix and a fund that posts on the morning of its close can never strike.
# PostingDoesNotUnexplainABreak goes red.
tla_check(
    name = "explanation_pinned_to_the_prefix_check",
    size = "medium",
    config = "ExplanationPinnedToThePrefix.cfg",
    module = "ExplanationPinnedToThePrefix.tla",
    tags = ["manual"],
    deps = [":close_gate"],
)
