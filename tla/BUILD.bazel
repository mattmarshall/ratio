load("@rules_tla//tla:defs.bzl", "tla_check", "tla_library")

package(default_visibility = ["//visibility:public"])

# ⛔ The properties Lean does not reach.
#
# `Ratio.Ingest` proves what resolution and parsing COMPUTE. It cannot say
# what a sequence of operations does to shared state — and that is where the
# bug that shipped lived: approving a rule deleted the templates beside it,
# after which every Lean theorem held vacuously over an empty set of facts.
tla_library(
    name = "control_plane",
    srcs = ["ControlPlane.tla"],
)

# The system as it is now. Both invariants must hold.
tla_check(
    name = "control_plane_check",
    size = "medium",
    config = "MCControlPlane.cfg",
    module = "MCControlPlane.tla",
    deps = [":control_plane"],
)

# Marking to market. `Ratio.Valuation` proves what ONE mark does; this is what
# a SEQUENCE of them does to the carrying value, which marking, trading and
# price corrections all write.
tla_library(
    name = "valuation",
    srcs = ["Valuation.tla"],
)

tla_check(
    name = "valuation_check",
    size = "medium",
    config = "MCValuation.cfg",
    module = "MCValuation.tla",
    deps = [":valuation"],
)

# Relieving tax lots at scale. `Ratio.Lots` proves the ARITHMETIC of one
# relief; twenty million lots do not fit in one application, and paging them
# through an I/O compartment into CPU workers is where a proved function starts
# giving a different answer.
tla_library(
    name = "lot_engine",
    srcs = ["LotEngine.tla"],
)

tla_check(
    name = "lot_engine_check",
    size = "medium",
    config = "MCLotEngine.cfg",
    module = "MCLotEngine.tla",
    deps = [":lot_engine"],
)

# Corporate actions arriving, being applied, and NAVs struck around them.
# `Ratio.Actions` proves what ONE does; non-idempotence and retroactivity are
# sequence problems, which is this.
tla_library(
    name = "actions",
    srcs = ["Actions.tla"],
)

tla_check(
    name = "actions_check",
    size = "medium",
    config = "MCActions.cfg",
    module = "MCActions.tla",
    deps = [":actions"],
)

# ─── failure-path probes ──────────────────────────────────────────────────
#
# Each of these MUST go red. Tagged manual so `bazel test //...` stays green;
# run them explicitly. A check that cannot fail is not a check, and this spec
# exists because two things that could not fail had already been believed.
tla_check(
    name = "approve_drops_sections_check",
    size = "medium",
    config = "ApproveDropsSections.cfg",
    module = "ApproveDropsSections.tla",
    tags = ["manual"],
    deps = [":control_plane"],
)

tla_check(
    name = "master_duplicates_check",
    size = "medium",
    config = "MasterDuplicates.cfg",
    module = "MasterDuplicates.tla",
    tags = ["manual"],
    deps = [":control_plane"],
)

# ⛔ Marking from COST rather than from the carrying value. Every mark posts the
# whole gain again — and the entry is still BALANCED, so the trial balance ties
# while the book is wrong. Conservation cannot catch this, which is exactly why
# the property is worth checking.
tla_check(
    name = "mark_from_cost_check",
    size = "medium",
    config = "MarkFromCost.cfg",
    module = "MarkFromCost.tla",
    tags = ["manual"],
    deps = [":valuation"],
)

# ⛔ Two sales inside one shard. Each one's arithmetic is impeccable — the
# proofs in `Ratio.Lots` hold of both — and the instrument ends up relieved for
# more than it held. Conservation of a single relief cannot see this.
tla_check(
    name = "shared_shard_check",
    size = "medium",
    config = "SharedShard.cfg",
    module = "SharedShard.tla",
    tags = ["manual"],
    deps = [":lot_engine"],
)

# ⛔ No record of having applied. A retry re-applies a split; the cost is
# unchanged so the trial balance still ties, and the position silently doubles.
# Every other write in this system is safe to retry, which is exactly why this
# one needs a guard rather than a habit.
tla_check(
    name = "reapply_action_check",
    size = "medium",
    config = "ReapplyAction.cfg",
    module = "ReapplyAction.tla",
    tags = ["manual"],
    deps = [":actions"],
)

# ⛔ Applied in arrival order rather than ex-date order. Actions do not commute
# — `Ratio.Actions.actions_do_not_commute` — so this is not a performance
# question, it decides whether the book can be brought up to date at all.
tla_check(
    name = "out_of_order_action_check",
    size = "medium",
    config = "OutOfOrderAction.cfg",
    module = "OutOfOrderAction.tla",
    tags = ["manual"],
    deps = [":actions"],
)

# ⛔ The derived read model, and the one way it silently produces a wrong figure.
#
# Twenty million lots do not scan through the journal quickly — 89 seconds at
# the rate `ratio_nav::closure::measure` reports — so reads move to a projection
# folded from a journal prefix. That is safe only if a strike pins the prefix it
# actually read. Pinning the journal HEAD while reading a lagging projection
# passes every downstream check: the trial balance ties, the digest is
# well-formed, and `ratio replay` disagrees with the figure it was asked to
# confirm.
#
# It also carries `Ratio.Actions.Factor`'s precondition into the system: under
# the factor representation nothing is applied, so a corporate action in a side
# plane is pinned by no strike and a replay reads whatever arrived since.
tla_library(
    name = "projection",
    srcs = ["Projection.tla"],
)

tla_check(
    name = "projection_check",
    size = "medium",
    config = "MCProjection.cfg",
    module = "MCProjection.tla",
    deps = [":projection"],
)

# ⛔ The strike pins the journal head while reading a lagging projection — the
# obvious, tempting bug, because the head is the number closest to hand.
# StrikeFoldsItsOwnPrefix goes red.
tla_check(
    name = "unpinned_projection_check",
    size = "medium",
    config = "UnpinnedProjection.cfg",
    module = "UnpinnedProjection.tla",
    tags = ["manual"],
    deps = [":projection"],
)

# ⛔ A rebuild that re-folds from zero onto state it already holds. Its claimed
# position stays honest and its contents do not, so nothing about the resulting
# number looks wrong — it is simply too big.
# ProjectionIsTheFold goes red.
tla_check(
    name = "rebuild_double_counts_check",
    size = "medium",
    config = "RebuildDoubleCounts.cfg",
    module = "RebuildDoubleCounts.tla",
    tags = ["manual"],
    deps = [":projection"],
)

# ⛔ Corporate actions in a side plane, which is where `Plane::Actions` has them
# today. `Ratio.Actions.Factor.an_unpinned_announcement_changes_the_answer` is
# one step of this; here it is a run.
# ReplayReproduces goes red.
tla_check(
    name = "announcements_in_side_log_check",
    size = "medium",
    config = "AnnouncementsInSideLog.cfg",
    module = "AnnouncementsInSideLog.tla",
    tags = ["manual"],
    deps = [":projection"],
)
