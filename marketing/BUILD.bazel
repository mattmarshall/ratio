load("@rules_tectonic//tectonic:defs.bzl", "tectonic_pdf")

package(default_visibility = ["//visibility:public"])

# The Ratio positioning brief — a marketing-oriented paper positioning the
# proposed Ratio ecosystem against SS&C Black Diamond and the legacy
# wealth-tech stack. Single-document compile (tectonic_pdf): main.tex pulls
# in the section and figure fragments and the brand logo. All visuals are
# native TikZ / pgfplots, so the whole brief is one hermetic tectonic action.
#
#   bazel build //marketing:positioning   ->  bazel-bin/marketing/positioning.pdf
tectonic_pdf(
    name = "positioning",
    main = "main.tex",
    srcs = glob([
        "sections/*.tex",
        "figures/*.tex",
        "figures/data/*.dat",
        "figures/*.pdf",
    ]),
)

# The licensing sweep. Ratio is AGPL-3.0 with a commercial license alongside it
# (LICENSING.md), and prose drifts back toward whatever the license used to be
# because nothing in a diff flags it. site/verify.py does this for the web
# pages; this is the same check for the LaTeX, over every document tree at once.
#
# ⚠ THIS COMMENT ITSELF DRIFTED. It called Ratio "NOT open source and NOT
# self-hostable" after the AGPL made both false, and stayed that way because the
# check reads .tex, not BUILD files.
sh_test(
    name = "language_test",
    size = "small",
    srcs = ["verify_language_test.sh"],
    args = [
        "$(rootpath verify_language.py)",
        "$(rootpaths :all_tex)",
    ],
    data = [
        "verify_language.py",
        ":all_tex",
    ],
)

filegroup(
    name = "all_tex",
    srcs = glob(["**/*.tex"]) + [
        "//competitive/specs:specs_tex",
        "//paper:paper_tex",
    ],
)
