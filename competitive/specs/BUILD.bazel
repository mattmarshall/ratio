    "data-aggregation",
    "trading-rebalancing",
    "model-management",
    "proposal-generation",
    "billing",
    "client-portal",
    "crm",
    "compliance",
    "risk-analytics",
    "business-intelligence",
    "alternative-investments",
    "integrations",
    "ai-insights",
    "data-governance",
    "specialized-servicing",
])
