exports_files(["src/types.ts"])

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

exports_files([
    "build.mjs",
    "wrap_console.py",
    "pnpm-lock.yaml",
    "package.json",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

# Typecheck, and emit JS for the bundler.
#
# `transpiler` has no default — rules_ts requires the choice, correctly, because
# tsc and swc disagree about enough to matter. tsc here: this is ~550 lines, the
# build is already fast, and one fewer toolchain is one fewer thing to pin.
ts_project(
    name = "ts",
    transpiler = "tsc",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    declaration = False,
    out_dir = "dist",
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules/@tanstack/react-query",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
)

# One bundle, no code splitting and no CDN. The console is served from the same
# Lambda as the API, and a second request for a chunk is a second cold start.
js_binary(
    name = "bundler",
    data = [
        ":node_modules/@tanstack/react-query",
        ":node_modules/esbuild",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":ts",
    ],
    entry_point = "build.mjs",
)

js_run_binary(
    name = "bundle",
    srcs = [
        ":node_modules/@tanstack/react-query",
        ":node_modules/esbuild",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":ts",
    ],
    args = ["console.js"],
    chdir = package_name(),
    mnemonic = "BundleConsole",
    outs = ["console.js"],
    tool = ":bundler",
)

# ⛔ The wire types in src/types.ts are hand-written to mirror console.proto.
# This asserts they still do — every message field, by name, in canonical JSON
# form. Same discipline as //crates/ratio-console:transcode_test: a mirror
# nothing compares is a mirror that drifts.

# The shell, with the stylesheet and the bundle inlined.
#
# One request serves the whole console. On Lambda a second request for a
# stylesheet is a second invocation and possibly a second cold start, and the
# whole page is smaller than the round trip it would save.
genrule(
    name = "console_html",
    srcs = [
        "index.html",
        "console.css",
        ":bundle",
    ],
    outs = ["console.html"],
    cmd = """
    python3 - "$(location index.html)" "$(location console.css)" \
             "$(location :bundle)" "$@" <<'PY'
import pathlib, sys, urllib.parse
shell, css, bundle, out = (pathlib.Path(p) for p in sys.argv[1:5])
svg = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
       '<rect width="64" height="64" rx="12" fill="#1B6440"/>'
       '<rect x="8" y="19" width="16.34" height="10" rx="2" fill="#FCFBF7"/>'
       '<rect x="29.34" y="19" width="26.66" height="10" rx="2" fill="#FCFBF7"/>'
       '<rect x="8" y="35" width="48" height="10" rx="2" fill="#FCFBF7"/></svg>')
html = shell.read_text()
for token, value in (("__CSS__", css.read_text()),
                     ("__BUNDLE__", bundle.read_text()),
                     ("__FAVICON__", "data:image/svg+xml," + urllib.parse.quote(svg, safe=""))):
    n = html.count(token)
    if n != 1:
        raise SystemExit(f"{token} appears {n} times, expected 1")
    html = html.replace(token, value)
out.write_text(html)
PY
    """,
    message = "Inlining the console",
)
