package(default_visibility = ["//visibility:public"])

# The five-minute demo, run end to end with no human in it.
#
# PLAN.md Stage 2 is "done when the five-minute script runs end to end without
# a rehearsal" — a claim that decays the moment nobody checks it. This target
# is the check. It is `medium` because step 6 posts ten thousand events and
# takes about half a minute; that number is from PLAN.md and is not worth
# trimming to make a test faster.
sh_test(
    name = "rehearse_test",
    size = "medium",
    srcs = ["rehearse.sh"],
    args = ["$(rootpath //crates/ratio)"],
    data = ["//crates/ratio"],
)

# The shadow run — PLAN.md Stage 3. Covers what the ratio-recon unit tests
# cannot: the three exit codes, that --post writes nothing for a refused file,
# and that the commands a report tells a reader to run actually exist.
sh_test(
    name = "shadow_run_test",
    size = "small",
    srcs = ["shadow-run.sh"],
    args = ["$(rootpath //crates/ratio)"],
    data = ["//crates/ratio"],
)

# `ratio bench` renders one run as a report and as JSON. This holds the two to
# the same figures — the defect it is for is a second MEASUREMENT rather than a
# second rendering, which would give two answers that both tie and disagree.
sh_test(
    name = "bench_renderings_test",
    size = "small",
    srcs = ["bench-renderings.sh"],
    args = ["$(rootpath //crates/ratio)"],
    data = ["//crates/ratio"],
)

# Two benchmarks at once used to delete each other's book, and the wrong answer
# tied — 22% of the lots in 22% of the time, trial balance 0. `medium` because
# it runs three benches, two of them concurrently.
sh_test(
    name = "bench_concurrent_test",
    size = "medium",
    srcs = ["bench-concurrent.sh"],
    args = ["$(rootpath //crates/ratio)"],
    data = ["//crates/ratio"],
)
