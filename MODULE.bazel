"""ratio — Lean-authored, Rust-emitted personal-finance app on the fastverk stack.

Phase 0: Rust toolchain + crate_universe so the Cargo workspace builds under Bazel.
Later phases add rules_lean (the Lean kernel + emitter), rules_aip (proto lint),
rules_rust_prost (gRPC), and meridian (TUI) — the latter two via local_path_override
since meridian/polyglot_ast are not yet in a public registry.
"""

module(name = "ratio", version = "0.0.0")

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Whitepaper toolchain. `//paper:ratio` compiles the formally-grounded
# whitepaper (theory, math, Lean-backed proofs, value prop) to a PDF via
# tectonic; the system architecture figure is rendered to vector PDF from a
# PlantUML source by rules_puml (Java/Batik/FOP, no external toolchain), and
# the conceptual diagrams + quantitative charts are native TikZ / pgfplots.
bazel_dep(name = "rules_tectonic", version = "0.2.0")
bazel_dep(name = "rules_puml", version = "0.0.2")

# Phase 2: the gRPC API contract + AIP lint. protobuf is a direct dep so the
# `@protobuf//...:prefer_prebuilt_protoc` flag (in .bazelrc) resolves.
bazel_dep(name = "rules_aip", version = "0.2.1")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "googleapis", version = "0.0.0-20260422-20ac242a")

# prost + tonic codegen for the gRPC server. The DEFAULT rules_rust_prost
# toolchain (with tonic) applies — ratio needs a real gRPC server, unlike
# meridian's wasm-constrained tonic-free override.
bazel_dep(name = "rules_rust_prost", version = "0.70.0")

# Rust toolchain pinned to 1.85.0 to match the fastverk ecosystem (meridian),
# so ratio's eventual @meridian//rust deps share one toolchain.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Our prost+tonic toolchain (runtimes = @crates) wins over rules_rust_prost's
# default, so codegen + consumers share one tonic. See //proto:prost_toolchain.
register_toolchains("//proto:prost_toolchain")

# Tectonic toolchain for `//paper`. rules_* modules don't propagate `use_repo`
# to dependents, so the extension + toolchain are wired here (rules_puml carries
# its own JVM/maven toolchain internally — no consumer wiring needed).
tectonic = use_extension("@rules_tectonic//tectonic:extensions.bzl", "tectonic")
use_repo(tectonic, "tectonic")
register_toolchains("@tectonic//:tectonic_toolchain_def")

# crate_universe reads the Cargo workspace; external crates resolve as @crates//:<name>.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/ratio-common:Cargo.toml",
        "//crates/ratio-kernel:Cargo.toml",
        "//crates/ratio-chart:Cargo.toml",
        "//crates/ratio-api:Cargo.toml",
        "//crates/ratio-tui:Cargo.toml",
        "//crates/ratio:Cargo.toml",
        "//rust/json_to_rust:Cargo.toml",
    ],
)
use_repo(crate, "crates")

# Lean toolchain (Phase 0b → Phase 1). The accounting domain is authored +
# proven in Lean and emitted to Rust via the vendored `Polyglot.Rust` builders
# + `lean_emit`. Dep-free Lean core, provisioned by rules_lean's lake.workspace
# (pinned v4.30.0-rc2 to match the polyglot emitter sources).
bazel_dep(name = "rules_lean", version = "0.5.1")

lake = use_extension("@rules_lean//lean:lake.bzl", "lake")
lake.workspace(
    name = "ratio_lean_ws",
    lakefile = "//lean:lakefile.lean",
    lake_manifest = "//lean:lake-manifest.json",
    lean_toolchain = "//lean:lean-toolchain",
)
use_repo(lake, "ratio_lean_ws")
register_toolchains("@ratio_lean_ws//:lean_toolchain_def")
