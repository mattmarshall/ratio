package(default_visibility = ["//visibility:public"])

# The calendar-bills Connect app is a sibling tree. Bazel does not
# build a WorkOS binary here; it holds the mapper to the catalog, to
# CreateBook(Personal) scheduled_* templates, and to the refusals
# #163 named.
#
# ⭐ THE GRANT PATH CALLS CONNECTAPIURL. fetch/deliver present a token.
# WorkOS dashboard registration stays leftover #22.
# Encrypted local activation is //connect:personal_activation_test; live
# calendar evidence stays on #163. Payroll / envelope kinds refuse.
# Recurrence is not expanded into the journal. screensFor is not forked.
# No kernel forecast RPC.
sh_test(
    name = "bills_test",
    size = "small",
    srcs = ["bills_test.sh"],
    args = [
        "$(rootpath bills.py)",
        "$(rootpath bills_test.py)",
        "$(rootpath app.json)",
        "$(rootpath //crates/ratio-console:src/book.rs)",
        "$(rootpath //:docs/connect-scopes.md)",
        "$(rootpath //console:src/lib/screens.ts)",
        "$(rootpath //proto:ratio/console/v1/console.proto)",
    ],
    data = [
        "//connect:grant.py",
        "bills.py",
        "bills_test.py",
        "app.json",
        "//crates/ratio-console:src/book.rs",
        "//:docs/connect-scopes.md",
        "//console:src/lib/screens.ts",
        "//proto:ratio/console/v1/console.proto",
    ],
)

sh_test(
    name = "google_calendar_test",
    size = "small",
    srcs = ["google_calendar_test.sh"],
    args = [
        "$(rootpath google_calendar.py)",
        "$(rootpath google_calendar_test.py)",
    ],
    data = [
        "//connect:grant.py",
        "bills.py",
        "google_calendar.py",
        "google_calendar_test.py",
        "google_calendar_test.sh",
        "testdata/events-page-1.json",
        "testdata/events-page-2.json",
    ],
)
