package(default_visibility = ["//visibility:public"])

# The audit-export Connect app is a sibling tree. Bazel does not build a
# WorkOS binary here; it holds the pack builder to the catalog, to
# PeriodClose / NavStrike / Break / BreakExplanation field names, and
# to the refusals the issue named.
#
# ⛔ IT DOES NOT SAY THE GRANT PATH EXISTS. fetch_cites() / deliver()
# must refuse. Accepting Connect tokens is leftover #22. A missing
# cite stays unset in the manifest — never a silent empty file, a
# billed-zero, a NAV-zero, or an empty-digest-as-success. No kernel
# blob store. No period-close replacement. screensFor is not forked.
sh_test(
    name = "pack_test",
    size = "small",
    srcs = ["pack_test.sh"],
    args = [
        "$(rootpath pack.py)",
        "$(rootpath pack_test.py)",
        "$(rootpath app.json)",
        "$(rootpath //crates/ratio-rules:src/lib.rs)",
        "$(rootpath //:docs/connect-scopes.md)",
        "$(rootpath //console:src/lib/screens.ts)",
        "$(rootpath //proto:ratio/console/v1/console.proto)",
        "$(rootpath //console:src/wire/types.ts)",
        "$(rootpath //proto:ratio/v1/recon.proto)",
    ],
    data = [
        "pack.py",
        "pack_test.py",
        "app.json",
        "//crates/ratio-rules:src/lib.rs",
        "//:docs/connect-scopes.md",
        "//console:src/lib/screens.ts",
        "//proto:ratio/console/v1/console.proto",
        "//console:src/wire/types.ts",
        "//proto:ratio/v1/recon.proto",
    ],
)
