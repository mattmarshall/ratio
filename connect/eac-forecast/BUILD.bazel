package(default_visibility = ["//visibility:public"])

# The EAC / forecast Connect app is a sibling tree. Bazel does not
# build a WorkOS binary here; it holds the pack builder to the catalog,
# to Project /budget remaining-to-spend, and to the refusals the issue
# named.
#
# ⭐ THE GRANT PATH CALLS CONNECTAPIURL. fetch/deliver present a token. WorkOS dashboard registration stays leftover #22. Unset remaining-to-spend
# stays unset — never a silent EAC of 0. No kernel forecast RPC.
# PROJECT chrome is not forked. /budget still does not forecast.
sh_test(
    name = "pack_test",
    size = "small",
    srcs = ["pack_test.sh"],
    args = [
        "$(rootpath pack.py)",
        "$(rootpath pack_test.py)",
        "$(rootpath app.json)",
        "$(rootpath //crates/ratio-rules:src/lib.rs)",
        "$(rootpath //:docs/connect-scopes.md)",
        "$(rootpath //console:src/lib/screens.ts)",
        "$(rootpath //proto:ratio/console/v1/console.proto)",
    ],
    data = [
        "//connect:grant.py",
        "pack.py",
        "pack_test.py",
        "app.json",
        "//crates/ratio-rules:src/lib.rs",
        "//:docs/connect-scopes.md",
        "//console:src/lib/screens.ts",
        "//proto:ratio/console/v1/console.proto",
    ],
)
