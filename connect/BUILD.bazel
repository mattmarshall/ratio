package(default_visibility = ["//visibility:public"])

exports_files([
    "grant.py",
    "oauth.py",
    "personal_activation.py",
])

# Shared Connect grant path. First-party apps call ConnectApiUrl
# with a verified Connect access token. Membership still required.
# A Connect token never takes RATIO_DEMO_OPEN and never matches
# org:{id}. WorkOS dashboard registration stays leftover #22.
sh_test(
    name = "grant_test",
    size = "small",
    srcs = ["grant_test.sh"],
    args = [
        "$(rootpath grant.py)",
        "$(rootpath grant_test.py)",
    ],
    data = [
        "grant.py",
        "grant_test.py",
    ],
)

# A public native client completes WorkOS Connect authorization without
# creating or persisting a client secret. The loopback callback, PKCE, state,
# and manifest scope boundary are all part of the contract.
sh_test(
    name = "oauth_test",
    size = "small",
    srcs = ["oauth_test.sh"],
    args = [
        "$(rootpath oauth.py)",
        "$(rootpath oauth_test.py)",
        "$(rootpath //connect/bank-feed:app.json)",
        "$(rootpath //connect/bank-balance-predictor:app.json)",
        "$(rootpath //connect/calendar-bills:app.json)",
        "$(rootpath //connect/goals:app.json)",
        "$(rootpath //connect/tax-pack:app.json)",
        "$(rootpath //connect/ecb-rates:app.json)",
    ],
    data = [
        "oauth.py",
        "oauth_test.py",
        "//connect/bank-feed:app.json",
        "//connect/bank-balance-predictor:app.json",
        "//connect/calendar-bills:app.json",
        "//connect/goals:app.json",
        "//connect/tax-pack:app.json",
        "//connect/ecb-rates:app.json",
    ],
)

# Local Personal provider lifecycle. Provider credentials and retry state are
# encrypted per WorkOS-subject/book membership and never cross the CLI surface.
sh_test(
    name = "personal_activation_test",
    size = "small",
    srcs = ["personal_activation_test.sh"],
    args = [
        "$(rootpath personal_activation.py)",
        "$(rootpath personal_activation_test.py)",
        "$(rootpath //:docs/personal-provider-activation.md)",
    ],
    data = [
        "grant.py",
        "oauth.py",
        "personal_activation.py",
        "personal_activation_test.py",
        "//:docs/personal-provider-activation.md",
        "//connect/bank-feed:mapper.py",
        "//connect/bank-feed:plaid.py",
        "//connect/bank-feed:plaid_link.py",
        "//connect/calendar-bills:bills.py",
        "//connect/calendar-bills:google_calendar.py",
    ],
)
