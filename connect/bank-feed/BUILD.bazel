package(default_visibility = ["//visibility:public"])

# The bank-feed Connect app is a sibling tree. Bazel does not build a
# WorkOS binary here; it holds the mapper to the catalog, to
# CreateBook(Personal), and to the refusals the issue named.
#
# ⭐ THE GRANT PATH CALLS CONNECTAPIURL. fetch/deliver present a token. WorkOS
# dashboard registration stays leftover #22. Encrypted local activation is
# //connect:personal_activation_test; live bank evidence stays on #165.
sh_test(
    name = "mapper_test",
    size = "small",
    srcs = ["mapper_test.sh"],
    args = [
        "$(rootpath mapper.py)",
        "$(rootpath mapper_test.py)",
        "$(rootpath app.json)",
        "$(rootpath //crates/ratio-console:src/book.rs)",
        "$(rootpath //:docs/connect-scopes.md)",
    ],
    data = [
        "//connect:grant.py",
        "mapper.py",
        "mapper_test.py",
        "app.json",
        "//crates/ratio-console:src/book.rs",
        "//:docs/connect-scopes.md",
    ],
)

sh_test(
    name = "plaid_test",
    size = "small",
    srcs = ["plaid_test.sh"],
    args = [
        "$(rootpath plaid.py)",
        "$(rootpath plaid_test.py)",
    ],
    data = [
        "//connect:grant.py",
        "mapper.py",
        "plaid.py",
        "plaid_test.sh",
        "plaid_test.py",
        "testdata/sync-page-1.json",
        "testdata/sync-page-2.json",
    ],
)

sh_test(
    name = "plaid_link_test",
    size = "small",
    srcs = ["plaid_link_test.sh"],
    args = [
        "$(rootpath plaid_link.py)",
        "$(rootpath plaid_link_test.py)",
    ],
    data = [
        "//connect:grant.py",
        "mapper.py",
        "plaid.py",
        "plaid_link.py",
        "plaid_link_test.py",
        "plaid_link_test.sh",
        "testdata/link-create.json",
        "testdata/token-exchange.json",
    ],
)
