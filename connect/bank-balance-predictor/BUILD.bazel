package(default_visibility = ["//visibility:public"])

# The bank-balance predictor Connect app is a sibling tree. Bazel
# does not build a WorkOS binary here; it holds the mapper to the
# catalog, to CreateBook(Personal) forecast_* templates, and to the
# refusals #163 named.
#
# ⛔ IT DOES NOT SAY THE GRANT PATH EXISTS. fetch_statements() and
# deliver() must refuse. Token validation is leftover #22 / #150.
# Live bank OAuth is leftover on #163. Payroll / envelope kinds
# refuse. screensFor is not forked. No kernel forecast RPC.
sh_test(
    name = "predictor_test",
    size = "small",
    srcs = ["predictor_test.sh"],
    args = [
        "$(rootpath predictor.py)",
        "$(rootpath predictor_test.py)",
        "$(rootpath app.json)",
        "$(rootpath //crates/ratio-console:src/book.rs)",
        "$(rootpath //:docs/connect-scopes.md)",
        "$(rootpath //console:src/lib/screens.ts)",
        "$(rootpath //proto:ratio/console/v1/console.proto)",
    ],
    data = [
        "predictor.py",
        "predictor_test.py",
        "app.json",
        "//crates/ratio-console:src/book.rs",
        "//:docs/connect-scopes.md",
        "//console:src/lib/screens.ts",
        "//proto:ratio/console/v1/console.proto",
    ],
)
