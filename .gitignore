# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Bazel convenience symlinks (build outputs)
bazel-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# site/ — generated pages and the generators' venv.
# Edit site/*.src.html and site/style.css; the built pages are regenerated on
# every run. Listing them individually went stale the moment a page was added,
# so match the shape instead and keep the sources.
site/*.html
!site/*.src.html
site/_site/
/_site/
site/.venv/
site/photos/_demo.png

# Python bytecode — build.py and the generators get imported during authoring.
__pycache__/
*.pyc

# Built by .github/workflows/deploy.yml into the Docker build context.
# Generated per deploy from deploy/seed-demo-book.sh — never committed, because
# a book checked in as bytes rots silently the first time a format changes.
/deploy/ratio
/deploy/demo-book/

# The console's dependencies and build output. Vercel builds this, not Bazel —
# see the ⛔ in MODULE.bazel for why the JS toolchain is not in the Bazel graph.
/console/node_modules/
/console/.next/
/console/*.tsbuildinfo
/console/.env
/console/.env.local
/console/.env.*.local
/deploy/demo-funds/
