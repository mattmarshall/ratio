package(default_visibility = ["//visibility:public"])

# Exposed for crate_universe's `manifests` (the workspace root manifest).
exports_files(["Cargo.toml"])

# Convenience: `bazel run //:ratio`.
alias(
    name = "ratio",
    actual = "//crates/ratio:ratio",
)

# PLAN.md refuses to build things. This checks it is still telling the truth.
#
# ⛔ IT WAS NOT. The refusal list had eleven entries on 2026-08-07 and four of
# them were built on 08-09 and 08-10 with the list untouched. For two days the
# plan and the repository disagreed about what the product is and nothing said
# so — every individual commit was defensible, which is what made it invisible.
#
# ⚠ CI SKIPS `**/*.md`, so this does not run when someone edits the plan. It
# runs when someone builds CODE, which is the right way round: the moment to
# notice the contradiction is the commit that creates it.
sh_test(
    name = "plan_refusals_test",
    size = "small",
    srcs = ["plan_refusals_test.sh"],
    args = ["$(location PLAN.md)"],
    data = ["PLAN.md"],
)

# The scale screen offers three shapes to fold. This checks they are the shapes
# HANDOFF.md measured — same spirit as the check above, and the same honest
# limitation: it cannot say either list is true, only that the two cannot drift
# apart in silence.
#
# ⛔ The confusion it exists for is real and cost a plan revision: the recorded
# twenty-million-lot row is 10,000 securities x 2,000 lots, while `ratio closure`
# dials 500 x 40,000. Same lot count, a twentieth of the mark cost, both
# captioned "twenty million tax lots".
sh_test(
    name = "scale_shapes_test",
    size = "small",
    srcs = ["scale_shapes_test.sh"],
    args = [
        "$(location //crates/ratio:src/watch.rs)",
        "$(location HANDOFF.md)",
    ],
    data = [
        "HANDOFF.md",
        "//crates/ratio:src/watch.rs",
    ],
)
