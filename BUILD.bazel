package(default_visibility = ["//visibility:public"])

# Exposed for crate_universe's `manifests` (the workspace root manifest).
exports_files(["Cargo.toml"])

# PLAN.md is DATA to the console-side BookKind check.
exports_files(["PLAN.md"])

# The Connect catalog is DATA to //:connect_scopes_test.
exports_files(["docs/connect-scopes.md"])

# ⛔ The deploy workflow is DATA to a test, because the capability flag it passes
# is part of whether `deploy/app.yaml` can be deployed at all. See
# `//deploy:iac_test`.
exports_files([".github/workflows/deploy.yml"])

# Convenience: `bazel run //:ratio`.
alias(
    name = "ratio",
    actual = "//crates/ratio:ratio",
)

# PLAN.md refuses to build things. This checks it is still telling the truth.
#
# ⛔ IT WAS NOT. The refusal list had eleven entries on 2026-08-07 and four of
# them were built on 08-09 and 08-10 with the list untouched. For two days the
# plan and the repository disagreed about what the product is and nothing said
# so — every individual commit was defensible, which is what made it invisible.
#
# ⚠ CI SKIPS `**/*.md`, so this does not run when someone edits the plan. It
# runs when someone builds CODE, which is the right way round: the moment to
# notice the contradiction is the commit that creates it.
sh_test(
    name = "plan_refusals_test",
    size = "small",
    srcs = ["plan_refusals_test.sh"],
    args = [
        "$(location PLAN.md)",
        "$(location //console:src/wire/types.ts)",
        "$(location //console:scripts/book_kinds_in_plan_test.py)",
    ],
    data = [
        "PLAN.md",
        "//console:src/wire/types.ts",
        "//console:scripts/book_kinds_in_plan_test.py",
    ],
)

# The scale screen offers three shapes to fold. This checks they are the shapes
# HANDOFF.md measured — same spirit as the check above, and the same honest
# limitation: it cannot say either list is true, only that the two cannot drift
# apart in silence.
#
# ⛔ The confusion it exists for is real and cost a plan revision: the recorded
# twenty-million-lot row is 10,000 securities x 2,000 lots, while `ratio closure`
# dials 500 x 40,000. Same lot count, a twentieth of the mark cost, both
# captioned "twenty million tax lots".
sh_test(
    name = "scale_shapes_test",
    size = "small",
    srcs = ["scale_shapes_test.sh"],
    args = [
        "$(location //crates/ratio:src/scale.rs)",
        "$(location HANDOFF.md)",
    ],
    data = [
        "HANDOFF.md",
        "//crates/ratio:src/scale.rs",
    ],
)

# The Connect catalog is a contract. This holds PLAN.md, HANDOFF.md and
# docs/connect-scopes.md to the same frozen strings — same spirit as the
# two checks above, and the same honest limitation: it cannot say the
# grant helper exists, only that the three documents cannot drift apart.
#
# ⚠ CI SKIPS `**/*.md`, so a docs-only edit of the catalog would not run
# this. The script is the code half; adding or renaming a scope is a
# change to this file as well, which is the moment somebody notices.
# A later commit that only touches markdown will not re-run this target
# on synchronize — keep the frozen list and the script in the same edit.
sh_test(
    name = "connect_scopes_test",
    size = "small",
    srcs = ["connect_scopes_test.sh"],
    args = [
        "$(location docs/connect-scopes.md)",
        "$(location PLAN.md)",
        "$(location HANDOFF.md)",
    ],
    data = [
        "docs/connect-scopes.md",
        "PLAN.md",
        "HANDOFF.md",
    ],
)
