load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# `generated.rs` is Lean-authored (//lean:Ratio/Closure/Emit.lean): the cost
# model — what a period end reads, term by term. Rendered straight into the
# crate's src so the proved function and the running one are one DAG edge.
genrule(
    name = "generated_rs",
    srcs = ["//lean:ratio_closure_ast"],
    outs = ["src/generated.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_closure_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

rust_library(
    name = "ratio-nav",
    srcs = glob(["src/*.rs"]) + [":generated_rs"],
    crate_name = "ratio_nav",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-common",
        "//crates/ratio-rules",
        "//crates/ratio-ingest",
        "//crates/ratio-project",
        "//crates/ratio-store",
        "@crates//:anyhow",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "ratio-nav_test",
    crate = ":ratio-nav",
    edition = "2021",
)
