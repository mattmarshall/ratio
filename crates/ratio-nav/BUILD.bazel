load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ratio-nav",
    srcs = glob(["src/*.rs"]),
    crate_name = "ratio_nav",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-store",
        "@crates//:anyhow",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "ratio-nav_test",
    crate = ":ratio-nav",
    edition = "2021",
)
