load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ratio-api",
    srcs = ["src/lib.rs"],
    crate_name = "ratio_api",
    edition = "2021",
    deps = [
        "//crates/ratio-kernel",
        "//proto:ratio_rust_proto",  # generated crate `ratio_proto` (ratio.v1)
    ],
)

rust_test(
    name = "ratio-api_test",
    crate = ":ratio-api",
    edition = "2021",
)
