load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml", "src/rest.rs", "src/json.rs"])

rust_library(
    name = "ratio-api",
    srcs = [
        "src/json.rs",
        "src/lib.rs",
        "src/rest.rs",
    ],
    crate_name = "ratio_api",
    edition = "2021",
    deps = [
        "//crates/ratio-chart",
        "//crates/ratio-kernel",
        "//crates/ratio-store",
        "//proto:ratio_rust_proto",  # generated crate `ratio_proto` (ratio.v1)
        "@crates//:anyhow",
        "@crates//:axum",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tower",
    ],
)

rust_test(
    name = "ratio-api_test",
    crate = ":ratio-api",
    edition = "2021",
)

# ⛔ The REST route table in `src/rest.rs` is hand-written, like the console's.
# This reads the descriptor set `//proto:ratio_proto` compiles to and asserts
# the table is exactly the set of google.api.http rules on Ledger and Chart —
# drift in either direction is a failing build rather than a 404 a customer
# finds. Same discipline as //crates/ratio-console:transcode_test.
sh_test(
    name = "rest_routes_test",
    size = "small",
    srcs = ["rest_routes_test.sh"],
    args = [
        "$(rootpath rest_routes_test.py)",
        "$(rootpath //proto:ratio_proto)",
        "$(rootpath src/rest.rs)",
    ],
    data = [
        "rest_routes_test.py",
        "src/rest.rs",
        "//proto:ratio_proto",
    ],
)
