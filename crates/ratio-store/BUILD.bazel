load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ratio-store",
    srcs = glob(["src/*.rs"]),
    crate_name = "ratio_store",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-common",
        "//crates/ratio-chart",
        "//crates/ratio-kernel",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "ratio-store_test",
    crate = ":ratio-store",
    edition = "2021",
)
