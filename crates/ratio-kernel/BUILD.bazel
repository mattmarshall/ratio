load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# `generated.rs` (Posting/Transaction) is Lean-authored (//lean:Ratio/Kernel/Emit.lean),
# emitted via json_to_rust and consumed directly as a src — fully DAG, no copy.
genrule(
    name = "generated_rs",
    srcs = ["//lean:ratio_kernel_ast"],
    outs = ["src/generated.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_kernel_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

# `lib.rs` is the hand-written shell + the conservation check (mirrors Ratio.Core);
# `:generated_rs` is the Lean-emitted records module.
rust_library(
    name = "ratio-kernel",
    srcs = [
        "src/lib.rs",
        ":generated_rs",
    ],
    crate_name = "ratio_kernel",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = ["//crates/ratio-common"],
)

rust_test(
    name = "ratio-kernel_test",
    crate = ":ratio-kernel",
    edition = "2021",
)
