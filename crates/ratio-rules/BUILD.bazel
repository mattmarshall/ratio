load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ratio-rules",
    srcs = glob(["src/*.rs"]),
    crate_name = "ratio_rules",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-chart",
        "//crates/ratio-common",
        "//crates/ratio-kernel",
        "//crates/ratio-store",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:toml",
    ],
)

rust_test(
    name = "ratio-rules_test",
    crate = ":ratio-rules",
    edition = "2021",
)
