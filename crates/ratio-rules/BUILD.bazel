load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    # The tax-pack Connect builder (#166) holds its lot-terms cites
    # to RuleSet's live field names. The AIA pay-app packer (#184)
    # holds `[project] budget` / phase rows the same way. Exporting
    # the source is a cross-check, not a kernel RPC.
    "src/lib.rs",
])

# The grading decision, Lean-authored (//lean:Ratio/Tolerance/Emit.lean). The
# WALK over a report's lines is the console's; what is emitted is what it decides
# about each difference, and whether a declared tolerance is usable at all.
genrule(
    name = "generated_tolerance_rs",
    srcs = ["//lean:ratio_tolerance_ast"],
    outs = ["src/generated_tolerance.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_tolerance_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

rust_library(
    name = "ratio-rules",
    srcs = glob(["src/*.rs"]) + [":generated_tolerance_rs"],
    crate_name = "ratio_rules",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-chart",
        "//crates/ratio-common",
        "//crates/ratio-kernel",
        "//crates/ratio-store",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:toml",
    ],
)

rust_test(
    name = "ratio-rules_test",
    crate = ":ratio-rules",
    edition = "2021",
)
