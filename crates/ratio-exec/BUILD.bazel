load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# `generated.rs` is Lean-authored (//lean:Ratio/Exec/Emit.lean): the planner's
# decision — whether another partition buys anything — and the max that says
# what a plan takes. The FOLDS are in lib.rs and the DECISION is emitted, the
# same arrangement as //crates/ratio-ingest, and
# `Ratio.Exec.a_plan_that_cannot_be_helped_takes_its_io` is why the two cannot
# come to disagree.
genrule(
    name = "generated_rs",
    srcs = ["//lean:ratio_exec_ast"],
    outs = ["src/generated.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_exec_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

rust_library(
    name = "ratio-exec",
    srcs = glob(["src/*.rs"]) + [":generated_rs"],
    crate_name = "ratio_exec",
    edition = "2021",
    deps = ["@crates//:anyhow"],
)

rust_test(
    name = "ratio-exec_test",
    crate = ":ratio-exec",
    edition = "2021",
)
