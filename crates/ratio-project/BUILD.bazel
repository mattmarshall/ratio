load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_shared_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])
exports_files(["tests/object_store_registry_gate.py"])

# ⛔ The derived read model. `//tla:projection_check` is its safety argument and
# `//tla:unpinned_projection_check` is the failure it prevents: a figure that
# pins one journal position and reads a projection built from another.
#
# The prevention is a TYPE. Every read returns `AsOf<T>`, which carries the
# prefix it was folded from, and there is no other way to get a number out of
# this crate — so a caller cannot pin the journal head while reading a lagging
# projection, because it never has the head to hand.
# The per-lot relief decisions, Lean-authored (//lean:Ratio/Lots/Emit.lean). The
# WALK is `src/relief.rs`; what is emitted is what the walk decides at each lot.
genrule(
    name = "generated_lots_rs",
    srcs = ["//lean:ratio_lots_ast"],
    outs = ["src/generated_lots.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_lots_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

rust_library(
    name = "ratio-project",
    srcs = glob(["src/*.rs"]) + [":generated_lots_rs"],
    crate_name = "ratio_project",
    edition = "2021",
    deps = [
        "//crates/ratio-common",
        "//crates/ratio-ingest",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "ratio-project_test",
    crate = ":ratio-project",
    edition = "2021",
    # ⛔ The projection's NAV is checked against `ratio_nav::strike`, the path it
    # replaces — not against another projection, which would prove only that it
    # is consistent with its own mistake.
    deps = ["//crates/ratio-nav"],
)

# ⭐ #310: cold full replay, checkpoint load, and tail replay for the large
