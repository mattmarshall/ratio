    ],
)

rust_library(
    name = "backend_fixture",
    srcs = ["tests/backend_fixture.rs"],
    crate_name = "backend_fixture",
    crate_root = "tests/backend_fixture.rs",
    edition = "2021",
    deps = [
        ":ratio-project",
        "//crates/ratio-nav",
