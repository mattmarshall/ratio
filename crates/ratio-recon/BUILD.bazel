load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ratio-recon",
    srcs = glob(["src/*.rs"]),
    crate_name = "ratio_recon",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-common",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "//proto:ratio_rust_proto",  # generated crate `ratio_proto` (ratio.v1)
        "@crates//:anyhow",
        "@crates//:prost",
    ],
)

rust_test(
    name = "ratio-recon_test",
    crate = ":ratio-recon",
    edition = "2021",
)
