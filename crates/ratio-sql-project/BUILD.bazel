load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml", "schema.sql", "fold_scale.recorded.json"])

# ⛔ Stage E table projection. `//tla:sql_projection_check` is the safety
# argument: a figure is folded from ONE journal prefix across every table.
# `schema.sql` is the Postgres contract; the crate is the denotational store
# those tables name, and `PgProjection` applies the same file to a live
# engine. The journal stays the system of record.
#
# ⚠ The 140M-entry / 40GB journal fold stays on Fargate ScaleTask.
# The measured 20M-lot projection fold is `:fold_scale_test` (HANDOFF
# geometry 10,000 × 2,000). Planner pushdown vs `Pg.Rel.Semantics` is
# `src/plan.rs`. Console / API reads go through `ProjectionReads`
# when `RATIO_PG_URL` is set. The journal stays the system of record.
# This package must not grow a silent SQL FIFO: relief goes through
# `ratio_project::relief`, which is the walk `Ratio.Lots` proves.

rust_library(
    name = "ratio-sql-project",
    srcs = glob(["src/*.rs"]),
    compile_data = ["schema.sql"],
    crate_name = "ratio_sql_project",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//crates/ratio-nav",
        "//crates/ratio-project",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "@crates//:anyhow",
    ],
)

rust_test(
    name = "ratio-sql-project_test",
    crate = ":ratio-sql-project",
    compile_data = ["schema.sql"],
    edition = "2021",
)

# ⛔ NOT A TLA PROBE. `manual` keeps this out of `bazel test //...` so a
# developer without a server stays green — the same tag the probes use for
# the opposite reason (those must FAIL). CI runs this target by name
# against a Postgres service container and it must PASS. A skip-if-unset
# would be the green suite that tests nothing.
#
# `no-sandbox` + `requires-network`: the test talks to localhost via `psql`
# on PATH. A hermetic sandbox has neither.
rust_test(
    name = "pg_engine_test",
    srcs = ["tests/pg_live.rs"],
    crate_name = "pg_engine_test",
    crate_root = "tests/pg_live.rs",
    edition = "2021",
    size = "small",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":ratio-sql-project",
        "//crates/ratio-nav",
        "//crates/ratio-project",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "@crates//:anyhow",
    ],
)

# ⭐ THE 20M CLAIM. HANDOFF geometry 10,000 × 2,000, folded through
# `relieve_by`, digest published. Not the 140M-entry journal. `large`
# because twenty million lots are the thing being measured — a small
# stand-in would be the green suite that tests nothing.
rust_test(
    name = "fold_scale_test",
    srcs = ["tests/fold_scale.rs"],
    crate_name = "fold_scale_test",
    crate_root = "tests/fold_scale.rs",
    edition = "2021",
    size = "large",
    deps = [
        ":ratio-sql-project",
    ],
)
