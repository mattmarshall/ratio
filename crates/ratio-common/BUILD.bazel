load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# `generated.rs` is Lean-authored (//lean:Ratio/Common/Emit.lean): the Lean emit
# (//lean:ratio_common_ast, syn-serde JSON) rendered to Rust by json_to_rust.
# It's a direct src of the crate below — the whole Lean→Rust chain is one DAG
# edge, so there's nothing to copy and nothing to drift.
genrule(
    name = "generated_rs",
    srcs = ["//lean:ratio_common_ast"],
    outs = ["src/generated.rs"],
    cmd = "$(execpath //rust/json_to_rust:json_to_rust) $(execpath //lean:ratio_common_ast) > $@",
    tools = ["//rust/json_to_rust:json_to_rust"],
)

# `lib.rs` is the hand-written shell (`mod generated; pub use generated::*;`);
# `:generated_rs` is the Lean-emitted module it includes.
rust_library(
    name = "ratio-common",
    srcs = [
        "src/lib.rs",
        "src/checked.rs",
        ":generated_rs",
    ],
    crate_name = "ratio_common",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = ["@crates//:anyhow"],
)

rust_test(
    name = "ratio-common_test",
    crate = ":ratio-common",
    edition = "2021",
)
