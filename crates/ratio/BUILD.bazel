load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "ratio",
    srcs = [
        "src/main.rs",
        "src/scale.rs",
        "src/watch.rs",
    ],
    edition = "2021",
    deps = [
        "//crates/ratio-api",
        "//crates/ratio-agent",
        "//crates/ratio-chart",
        "//crates/ratio-console",
        "//crates/ratio-common",
        "//crates/ratio-kernel",
        "//crates/ratio-ingest",
        "//crates/ratio-mcp",
        "//crates/ratio-gen",
        "//crates/ratio-nav",
        "//crates/ratio-project",
        "//crates/ratio-recon",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "//crates/ratio-tui",
        "//proto:ratio_rust_proto",  # LedgerServer (ratio_proto)
        "@crates//:anyhow",
        "@crates//:aws-config",
        "@crates//:aws-sdk-ecs",
        "@crates//:aws-sdk-s3",
        "@crates//:libc",
        "@crates//:prost",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:toml",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "ratio_test",
    crate = ":ratio",
    edition = "2021",
)
