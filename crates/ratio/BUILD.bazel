load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "ratio",
    srcs = [
        "src/main.rs",
        "src/watch.rs",
        "src/console_html.rs",
    ],
    edition = "2021",
    deps = [
        "//crates/ratio-api",
        "//crates/ratio-agent",
        "//crates/ratio-chart",
        "//crates/ratio-console",
        "//crates/ratio-common",
        "//crates/ratio-kernel",
        "//crates/ratio-mcp",
        "//crates/ratio-recon",
        "//crates/ratio-rules",
        "//crates/ratio-store",
        "//crates/ratio-tui",
        "//proto:ratio_rust_proto",  # LedgerServer (ratio_proto)
        "@crates//:anyhow",
        "@crates//:libc",
        "@crates//:prost",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "ratio_test",
    crate = ":ratio",
    edition = "2021",
)

# The console, wrapped as a Rust source file.
#
# In THIS package, and with the output named `src/console_html.rs`, so it lands
# next to watch.rs — `#[path]` resolves relative to the including file, and a
# generated file in //web lands in bin/web, which is nowhere near
# bin/crates/ratio/src. That mismatch cost two builds to see.
genrule(
    name = "console_rs",
    srcs = ["//web:console_html"],
    outs = ["src/console_html.rs"],
    tools = ["//web:wrap_console.py"],
    cmd = "python3 $(location //web:wrap_console.py) $(location //web:console_html) $@",
    message = "Wrapping the console for Rust",
)
