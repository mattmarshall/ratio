# ⚠ THE MARKETING SITE IS NOT BUILT BY BAZEL, AND THIS FILE DOES NOT CHANGE THAT.
#
# `site/build.py` is standard-library Python with no network and no
# dependencies, `site/verify.py` holds every assertion, and
# `.github/workflows/site.yml` runs both. There are no build or test targets
# here on purpose.
#
# This file exists for one label: `//console:tokens_test` reads `style.css` to
# assert the console has not grown a second design system. `console/src/app/
# globals.css` opens by claiming "site/style.css is the source; this page is a
# consumer of that system rather than a second one", and that claim was
# unchecked until the console moved out of the binary.
#
# ⚠ `build.yml` ignores `site/**`, so a site-only push does NOT run that Bazel
# test. `site.yml` runs the same script directly for exactly that reason —
# a token changed here has to go red in the workflow that owns this directory,
# not on somebody else's next commit.

exports_files(["style.css"])
