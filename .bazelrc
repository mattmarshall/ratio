common --enable_bzlmod

# Proto: resolve the toolchain + use the prebuilt protoc (don't build it from
# source) — for the AIP contract under //proto.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# Resolve the public fastverk registry first (rules_aip, rules_lean, …), then BCR
# (rules_rust, protobuf, …). meridian + polyglot_ast come via local_path_override
# (MODULE.bazel) until they're published — premium registry is retired.
common --registry=https://raw.githubusercontent.com/fastverk/bazel-registry/main/
common --registry=https://bcr.bazel.build
