exports_files(["ratio/v1/console.proto"])

load("@rules_aip//aip:defs.bzl", "aip_proto_library", "aip_proto_lint")
load("@rules_rust//rust:defs.bzl", "rust_library_group")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library", "rust_prost_toolchain")

package(default_visibility = ["//visibility:public"])

# proto_library + the standard AIP googleapis deps (annotations, field_behavior,
# resource, client). strip_import_prefix makes the import path
# `ratio/v1/ledger.proto` match `package ratio.v1` (AIP-191).
aip_proto_library(
    name = "ratio_proto",
    srcs = [
        "ratio/v1/chart.proto",
        "ratio/v1/console.proto",
        "ratio/v1/ledger.proto",
        "ratio/v1/recon.proto",
    ],
    strip_import_prefix = "/proto",
    # google.protobuf.Timestamp, for NavStrike.valuation_time. AIP-142 wants a
    # Timestamp rather than a string for any time field, and a well-known type
    # still needs a declared dep even though protoc bundles it.
    deps = ["@protobuf//:timestamp_proto"],
)

# prost + tonic Rust codegen from the contract — the `ratio.v1` messages +
# `Ledger` service trait/client/server, for ratio-api.
rust_prost_library(
    name = "ratio_rust_proto",
    proto = ":ratio_proto",
)

# Custom prost+tonic toolchain whose runtimes are ratio's OWN @crates (tonic +
# prost), so the generated crate, ratio-api's `impl Ledger`, and the server all
# link ONE tonic — no cross-crate-universe version skew (the default toolchain
# bundles its own tonic). Registered in MODULE.bazel so it wins resolution.
rust_library_group(
    name = "prost_runtime",
    deps = ["@crates//:prost"],
)

rust_library_group(
    name = "tonic_runtime",
    deps = [
        ":prost_runtime",
        "@crates//:tonic",
    ],
)

rust_prost_toolchain(
    name = "prost_toolchain_impl",
    prost_plugin = "@rules_rust_prost//private/3rdparty/crates:protoc-gen-prost__protoc-gen-prost",
    prost_plugin_flag = "--plugin=protoc-gen-prost=%s",
    prost_runtime = ":prost_runtime",
    prost_types = "@crates//:prost-types",
    tonic_plugin = "@rules_rust_prost//private/3rdparty/crates:protoc-gen-tonic__protoc-gen-tonic",
    tonic_plugin_flag = "--plugin=protoc-gen-tonic=%s",
    tonic_runtime = ":tonic_runtime",
)

toolchain(
    name = "prost_toolchain",
    toolchain = ":prost_toolchain_impl",
    toolchain_type = "@rules_rust_prost//:toolchain_type",
)

# `bazel test //proto:ratio_aip_lint` runs the AIP linter over the contract.
# `has-comments` is disabled: rules_aip 0.2.1 lints a descriptor set built
# without source_code_info, so api-linter can't see proto comments at all (its
# own bookstore example fails the rule identically) — a false positive here, the
# contract is thoroughly commented. Re-enable once rules_aip emits source info.
aip_proto_lint(
    name = "ratio_aip_lint",
    disable_rules = ["core::0192::has-comments"],
    proto = ":ratio_proto",
)
